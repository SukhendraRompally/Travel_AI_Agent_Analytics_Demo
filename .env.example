# Expedia AI Travel Agent — Environment Configuration
# Copy this file to .env and fill in your Azure OpenAI credentials.

# Azure OpenAI — all four values required at startup
AZURE_OPENAI_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
